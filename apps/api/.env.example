# Copy to .env and fill in values
DEBUG=true
DATABASE_URL=postgresql+asyncpg://adminai:adminai@localhost:5432/adminai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=admin-ai-documents
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
STRUCTURED_RESPONSE_MODEL=gpt-4o-mini
INVESTIGATION_MAX_STEPS=8
INVESTIGATION_MAX_MODEL_CALLS=6
INVESTIGATION_MAX_RETRIEVAL_CALLS=6
INVESTIGATION_MAX_RUNTIME_SECONDS=300
CLERK_JWKS_URL=
CLERK_ISSUER=
CORS_ORIGINS=["http://localhost:3000"]
# Use `local` for the fixed local-dev principal or `clerk` for validated bearer JWTs.
ORION_AUTH_MODE=local
